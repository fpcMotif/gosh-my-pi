{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/fpcMotif/gosh-my-pi/apps/tui-go/prd.schema.json",
	"title": "gmp-tui-go PRD progress board",
	"description": "Schema for apps/tui-go/prd.json. Tracks ADR alignment, phases, tasks, risks, top priorities, and the most recent verification run for the gmp-tui-go (Crush hard-fork) implementation. The file is a committed, human-readable, machine-updatable progress board.",
	"type": "object",
	"required": [
		"meta",
		"progress_summary",
		"top_priorities",
		"adr_alignment",
		"phases",
		"tasks",
		"risks",
		"verification_run"
	],
	"additionalProperties": false,
	"properties": {
		"$schema": { "type": "string" },
		"meta": {
			"type": "object",
			"required": ["project", "version", "owner"],
			"additionalProperties": true,
			"properties": {
				"project": { "type": "string" },
				"version": { "type": "string" },
				"generated": { "type": "string", "format": "date-time" },
				"owner": { "type": "string" },
				"fork_of": { "type": "string" },
				"tui_fork_of": { "type": "string" },
				"tui_fork_release": { "type": "string" },
				"tui_fork_sha": { "type": "string" },
				"tui_fork_commit_in_repo": { "type": "string" },
				"bridge_commit": { "type": "string" },
				"bridge_branch": { "type": "string" },
				"bridge_worktree": { "type": "string" },
				"agent_protocol": { "type": "string" },
				"binary": { "type": "string" },
				"binary_previous": { "type": "string" },
				"binary_current": { "type": "string" },
				"binary_target": { "type": "string" },
				"module_path": { "type": "string" },
				"module_path_previous": { "type": "string" },
				"module_path_current": { "type": "string" },
				"module_path_target": { "type": "string" },
				"module_path_rewrite": { "type": "string" },
				"license_boundary": { "type": "object", "additionalProperties": { "type": "string" } },
				"plan_doc": { "type": "string" }
			}
		},
		"progress_summary": {
			"type": "object",
			"required": ["timestamp", "confidence", "confidence_note", "checked_evidence"],
			"additionalProperties": false,
			"properties": {
				"timestamp": { "type": "string", "format": "date-time" },
				"confidence": { "type": "string" },
				"confidence_note": { "type": "string" },
				"checked_evidence": { "type": "array", "items": { "type": "string" } },
				"missing_runtime_evidence": { "type": "array", "items": { "type": "string" } }
			}
		},
		"top_priorities": {
			"type": "array",
			"minItems": 3,
			"maxItems": 3,
			"items": {
				"type": "object",
				"required": ["rank", "title", "state", "why", "next_tasks"],
				"additionalProperties": false,
				"properties": {
					"rank": { "type": "integer", "minimum": 1, "maximum": 3 },
					"title": { "type": "string" },
					"state": { "enum": ["pending", "in_progress", "done", "blocked", "deferred"] },
					"why": { "type": "string" },
					"adr_refs": { "type": "array", "items": { "type": "string" } },
					"next_tasks": { "type": "array", "items": { "type": "string" } }
				}
			}
		},
		"adr_alignment": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["id", "status", "state", "decision", "evidence", "gaps", "next_actions"],
				"additionalProperties": false,
				"properties": {
					"id": { "type": "string" },
					"status": { "type": "string" },
					"state": { "enum": ["pending", "in_progress", "done", "blocked", "deferred"] },
					"decision": { "type": "string" },
					"evidence": { "type": "array", "items": { "type": "string" } },
					"gaps": { "type": "array", "items": { "type": "string" } },
					"next_actions": { "type": "array", "items": { "type": "string" } }
				}
			}
		},
		"phases": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["id", "name", "state"],
				"additionalProperties": false,
				"properties": {
					"id": { "type": "string", "pattern": "^P[0-9]+[a-z]?$" },
					"name": { "type": "string" },
					"state": { "enum": ["pending", "in_progress", "done", "blocked", "deferred"] },
					"branch": { "type": "string" },
					"commit": { "type": "string" },
					"production_couplings": { "type": "object", "additionalProperties": { "type": "string" } },
					"acceptance_criteria": { "type": "array", "items": { "type": "string" } },
					"evidence": { "type": "string" },
					"notes": { "type": "string" }
				}
			}
		},
		"tasks": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["id", "phase_id", "title", "state"],
				"additionalProperties": false,
				"properties": {
					"id": { "type": "string", "pattern": "^T-P[0-9]+-[A-Za-z0-9_-]+$" },
					"phase_id": { "type": "string", "pattern": "^P[0-9]+[a-z]?$" },
					"title": { "type": "string" },
					"state": { "enum": ["pending", "in_progress", "done", "blocked", "deferred"] },
					"priority": { "enum": ["low", "med", "high"] },
					"adr_refs": { "type": "array", "items": { "type": "string" } },
					"files_touched": { "type": "array", "items": { "type": "string" } },
					"verification": { "type": "array", "items": { "type": "string" } },
					"depends_on": {
						"type": "array",
						"items": { "type": "string", "pattern": "^T-P[0-9]+-[A-Za-z0-9_-]+$" }
					},
					"started_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
					"completed_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
					"notes": { "type": "string" }
				}
			}
		},
		"risks": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["id", "title", "severity"],
				"additionalProperties": false,
				"properties": {
					"id": { "type": "string", "pattern": "^R[0-9]+$" },
					"title": { "type": "string" },
					"severity": { "enum": ["low", "med", "high"] },
					"adr_refs": { "type": "array", "items": { "type": "string" } },
					"owner": { "type": "string" },
					"mitigation": { "type": "string" },
					"notes": { "type": "string" }
				}
			}
		},
		"verification_run": {
			"type": "object",
			"additionalProperties": true,
			"properties": {
				"timestamp": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
				"go_test_scoped": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
				"go_test_full": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
				"go_build": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
				"go_run_help": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
				"rpc_handshake": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
				"bun_check_ts": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
				"smoke_test": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
				"release_dry_run": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
			}
		}
	}
}
